{
  "appId": "com.aquaexpress.cdb",
  "appName": "AquaExpress",
  "webDir": "dist-mobile",
  "server": { "androidScheme": "https" },
  "ios": { "contentInset": "automatic" },
  "plugins": {
    "FirebaseMessaging": { "presentationOptions": ["badge", "sound", "alert"] },
    "SocialLogin": {
      "providers": { "google": true, "apple": false, "facebook": false, "twitter": false },
      "logLevel": 1
    }
  },
  "experimental": {
    "ios": { "spm": { "packageOptions": { "@capacitor-firebase/messaging": { "symlink": true } } } }
  }
}
